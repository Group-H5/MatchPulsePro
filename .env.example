# MatchPulse.pro example environment variables
# Copy to .env or set in your deployment provider (Vercel) with real values.

SITE_URL=https://matchpulse.pro
GEMINI_API_KEY=
SPORTS_API_PROVIDER=mock
RAPIDAPI_KEY=
RAPIDAPI_HOST=
# app
NEXT_PUBLIC_APP_URL = "http://localhost:3000"
NEXT_PUBLIC_APP_NAME = "Your App Name"

# theme
NEXT_PUBLIC_THEME = "default"

# appearance
NEXT_PUBLIC_APPEARANCE = "system"

# database
DATABASE_PROVIDER = "postgresql"
DATABASE_URL = ""
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "1"

# auth secret
# openssl rand -base64 32
AUTH_SECRET = ""